# ─────────────────────────────────────────────────────────────
#  TEMPLATE — copy to .env.local for local dev
#             paste into Vercel → Settings → Environment Variables
#             for production deployment
# ─────────────────────────────────────────────────────────────

# ── Admin credentials ─────────────────────────────────────────
# Username for the /admin login page
ADMIN_USERNAME=your_admin_username

# Password for the /admin login page  (use something strong in prod)
ADMIN_PASSWORD=

# ── JWT secret ───────────────────────────────────────────────
# Used to sign & verify a
# Multiple numbers: comma-separated  e.g. 919876543210,919123456789
# Leave blank to disable WhatsApp alerts entirely.
WHATSAPP_PHONE=
